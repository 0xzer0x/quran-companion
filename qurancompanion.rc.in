#include "winver.h"

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/logo.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x00040004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "000004b0"
    BEGIN
      VALUE "CompanyName", "Youssef Fathy"
      VALUE "FileDescription", "Quran Companion"
      VALUE "FileVersion", "@PROJECT_VERSION@.0"
      VALUE "LegalCopyright", "Copyright (C) 2026 Youssef Fathy"
      VALUE "InternalName", "qurancompanion"
      VALUE "OriginalFilename", "quran-companion.exe"
      VALUE "ProductName", "Quran Companion"
      VALUE "ProductVersion", "@PROJECT_VERSION@.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0, 1200
  END
END
